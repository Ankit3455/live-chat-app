rules_version = '2';

// Destined Cloud Storage rules, v2 (WP-23).
// Media currently goes to Cloudinary (StorageConfig.kUseCloudinaryForMedia);
// these rules cover the Firebase Storage fallback paths.
//
//  - Default deny.
//  - voices/{uid}/..., profile_photos/{uid}/..., avatars/{uid}_avatar_*.png:
//    signed-in read, owner-only write, type and size limits
//    (images <= 10 MB jpeg/png/webp, audio <= 10 MB).
//  - chat_media/{conversationId}/...: conversation participants only
//    (checked against Firestore). Blocks are enforced on the message write;
//    an upload alone is not visible to the other user.
//  - Legacy flat profile_photos/{timestamp}.jpg: create-only (no overwrite).
//    Only older app builds still write there (no uid folder, no contentType);
//    current builds write profile_photos/{uid}/. Drop it after a min-version gate.
//
// Client writes checked: firebase_storage_repo (uploadVoice/deleteVoice,
// uploadBytes for avatars, uploadImageFile, uploadChatImage, uploadChatAudio).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function maxMb(n) {
      return request.resource.size <= n * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }

    function isAudio() {
      return request.resource.contentType != null
        && request.resource.contentType.matches('audio/.*');
    }

    function isParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants;
    }

    match /voices/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isUser(uid) && isAudio() && maxMb(10);
      allow delete: if isUser(uid);
    }

    match /profile_photos/{uid}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isUser(uid) && isImage() && maxMb(10);
      allow delete: if isUser(uid);
    }

    // Legacy uploads without a uid folder: new files only, no overwrite or delete.
    match /profile_photos/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && fileName.matches('[0-9]+[.]jpg')
        && maxMb(10);
    }

    match /avatars/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && fileName.matches(request.auth.uid + '_avatar_[0-9]+[.]png')
        && isImage()
        && maxMb(10);
      allow delete: if signedIn() && fileName.matches(request.auth.uid + '_avatar_.*');
    }

    match /chat_media/{conversationId}/{fileName} {
      allow read: if isParticipant(conversationId);
      allow create: if isParticipant(conversationId)
        && ((isImage() && maxMb(10)) || (isAudio() && maxMb(10)));
      allow update, delete: if false;
    }
  }
}

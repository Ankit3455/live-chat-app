# Copy to functions/.env (gitignored). Non-secret switches only; secrets go to
# Secret Manager: firebase functions:secrets:set <NAME>

# Public OneSignal app id (defaults to the current app).
# ONESIGNAL_APP_ID=

# Require App Check on callables. Turn on only after App Check clients ship (O-6).
ENFORCE_APP_CHECK=false

# OneSignal Identity Verification is on (O-5): exports mintOneSignalJwt and
# allows message text in pushes. Secret: ONESIGNAL_IDENTITY_KEY (ES256 PEM).
ONESIGNAL_IDENTITY_VERIFIED=false

# Own TURN server (O-10): exports getTurnCredentials. Secret: TURN_SHARED_SECRET.
TURN_ENABLED=false
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
# TURN_TTL_SECONDS=3600

# Cloudinary Admin API (O-7): exports signCloudinaryUpload and
# processMediaCleanup, and destroys media of deleted messages immediately.
# Secret: CLOUDINARY_API_SECRET.
CLOUDINARY_ENABLED=false
# CLOUDINARY_CLOUD_NAME=dekipip5j
# CLOUDINARY_API_KEY=
# CLOUDINARY_SIGNED_PRESET=

// Destined Realtime Database rules, v2 (WP-23). Firebase rules files accept comments.
//
//  - Default deny.
//  - users/{uid} (astrology answers) and presence/{uid}: only the owner writes;
//    users/{uid} is owner-read only.
//  - incoming_calls/{uid}: only {uid} reads. A caller may create or update only
//    its own entry (callerId == auth.uid) and only when the callId starts with
//    "<callerUid>_<calleeUid>_" or the room rooms/{callId} already names the
//    caller and callee. A caller may remove its own entry; the owner may do anything,
//    including removing stale entries on app start or the whole node.
//    Consent and blocks (DEST-012, DEST-003): when config/enforceCallConsent is
//    true, a new ringing entry also needs call_consent/{calleeUid}/{callerUid}/{callType}
//    == true. That mirror is written only by a Function, set when both users
//    enabled the call type in their conversation and neither blocked the other.
//    Turn the flag on (console) only after that Function is deployed and backfilled.
//  - call_consent: server-only; caller and callee may read their pair.
//  - rooms/{callId}: only the callerId/calleeId stored in the room read or
//    write; caller creates it; ids immutable; offer and caller_candidates are
//    caller-only, answer and callee_candidates callee-only; filters/{uid} only
//    by that participant (short string).
//
//  - Account deletion runs in the client (Spark plan, no Functions): the owner
//    removes presence/{uid}, incoming_calls/{uid} and users/{uid}, and may remove
//    rooms it is caller or callee of (by id; rooms cannot be listed).
//
// Client writes checked: signaling_service (room skeleton, state, endRoom,
// onDisconnect end, offer/answer, candidates, deleteRoom, writeIncoming,
// closeIncomingForCallee, inbox cleanup), incoming_call_screen (inbox read),
// presence_service (presence/{me} + onDisconnect), astrology answers (users/{me}),
// account_deletion_service (presence/{me}, incoming_calls/{me}, users/{me} removal).
//
//  - thumb_live/{gameId}: a live Thumb War. p0 (the host) creates it naming
//    both players; ids immutable. Only the two players read. s (the fight) is
//    host-only; in/{uid} (button) and hb/{uid} (heartbeat) only by that player.
//    Either player may remove the node. Checked: thumb_live.dart.
{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "incoming_calls": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$callId": {
          ".read": "auth != null && data.child('callerId').val() === auth.uid",
          ".write": "auth != null && ((data.exists() && !newData.exists() && data.child('callerId').val() === auth.uid) || ((!data.exists() || data.child('callerId').val() === auth.uid) && newData.child('callerId').val() === auth.uid && ($callId.beginsWith(auth.uid + '_' + $uid + '_') || (root.child('rooms').child($callId).child('callerId').val() === auth.uid && root.child('rooms').child($callId).child('calleeId').val() === $uid)) && (data.exists() || root.child('config').child('enforceCallConsent').val() !== true || (newData.child('callType').isString() && root.child('call_consent').child($uid).child(auth.uid).child(newData.child('callType').val()).val() === true))))",
          ".validate": "newData.hasChildren(['callerId', 'status'])",
          "callerId": { ".validate": "newData.isString() && newData.val() !== $uid" },
          "status": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "callType": { ".validate": "newData.val() === 'audio' || newData.val() === 'video'" },
          "callerName": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "callerAvatar": { ".validate": "newData.isString() && newData.val().length <= 2048" },
          "roomId": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "timestamp": { ".validate": "newData.isNumber()" }
        }
      }
    },

    "call_consent": {
      "$calleeUid": {
        "$callerUid": {
          ".read": "auth != null && (auth.uid === $calleeUid || auth.uid === $callerUid)"
        }
      }
    },

    "rooms": {
      ".indexOn": ["state", "createdAt"],
      "$roomId": {
        ".read": "auth != null && (!data.exists() || data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('callerId').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('callerId').val() === auth.uid || data.child('calleeId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['callerId', 'calleeId'])",

        "callerId": {
          ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())"
        },
        "calleeId": {
          ".validate": "newData.isString() && newData.val() !== newData.parent().child('callerId').val() && (!data.exists() || newData.val() === data.val())"
        },
        "state": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('callerId').val() === auth.uid || root.child('rooms').child($roomId).child('calleeId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "offer": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('callerId').val() === auth.uid"
        },
        "answer": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('calleeId').val() === auth.uid"
        },
        "caller_candidates": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('callerId').val() === auth.uid"
        },
        "callee_candidates": {
          ".write": "auth != null && root.child('rooms').child($roomId).child('calleeId').val() === auth.uid"
        },
        "endedBy": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('callerId').val() === auth.uid || root.child('rooms').child($roomId).child('calleeId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "filters": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('rooms').child($roomId).child('callerId').val() === auth.uid || root.child('rooms').child($roomId).child('calleeId').val() === auth.uid)",
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        },
        "$other": {
          ".write": "auth != null && (root.child('rooms').child($roomId).child('callerId').val() === auth.uid || root.child('rooms').child($roomId).child('calleeId').val() === auth.uid)"
        }
      }
    },

    "thumb_live": {
      "$gameId": {
        ".read": "auth != null && (!data.exists() || data.child('p0').val() === auth.uid || data.child('p1').val() === auth.uid)",
        ".write": "auth != null && ((!data.exists() && newData.child('p0').val() === auth.uid) || (data.exists() && !newData.exists() && (data.child('p0').val() === auth.uid || data.child('p1').val() === auth.uid)))",
        "p0": { ".validate": "newData.isString() && (!data.exists() || data.val() === newData.val())" },
        "p1": { ".validate": "newData.isString() && newData.val() !== newData.parent().child('p0').val() && (!data.exists() || data.val() === newData.val())" },
        "s": {
          ".write": "auth != null && root.child('thumb_live').child($gameId).child('p0').val() === auth.uid",
          ".validate": "newData.hasChildren(['st', 'ph', 'hp', 'sta'])"
        },
        "in": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('thumb_live').child($gameId).child('p0').val() === auth.uid || root.child('thumb_live').child($gameId).child('p1').val() === auth.uid)",
            ".validate": "newData.isBoolean()"
          }
        },
        "hb": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (root.child('thumb_live').child($gameId).child('p0').val() === auth.uid || root.child('thumb_live').child($gameId).child('p1').val() === auth.uid)",
            ".validate": "newData.isNumber() && newData.val() <= now"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
